{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist-main",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": ["node", "electron"]
  },
  "include": ["src/main", "src/preload", "src/workers", "src/core", "src/shared", "src/adapters"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
